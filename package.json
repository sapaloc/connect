{
  "name": "connect-backend",
  "version": "1.0.0",
  "description": "Connect (Sapawoo x Number160) backend — Express + file NoSQL (data.json)",
  "main": "server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
