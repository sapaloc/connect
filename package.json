{
  "name": "connect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @connect/api --filter @connect/web dev",
    "build": "pnpm --filter @connect/web build",
    "migrate": "pnpm --filter @connect/api migrate",
    "check:syntax": "git ls-files '*.js' '*.mjs' | xargs -n1 node --check"
  }
}
