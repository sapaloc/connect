# Copy to .env for local development. Only apps/api/src/config/env.js reads these.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
MICROSITE_PUBLIC_BASE_URL=http://localhost:5173
PORT=3000

# Local Docker MongoDB replica set (see README). UAT uses the Atlas URI set by the Vercel integration.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=connect
DB_POOL_MAX=5

SESSION_SECRET=change-me-local-only
INTERNAL_JOB_SECRET=change-me-local-only

# Local seed accounts only (pnpm seed refuses outside APP_ENV=local/test). 8–32 chars, upper, lower, digit, special.
# Quote the value: an unquoted # starts a comment.
SEED_PASSWORD=

STORAGE_DRIVER=local
STORAGE_BUCKET=connect-files
STORAGE_ENDPOINT=
STORAGE_KEY=

LOG_LEVEL=info
