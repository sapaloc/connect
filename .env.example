# Copy to .env for local development. Only apps/api/src/config/env.js reads these.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
MICROSITE_PUBLIC_BASE_URL=http://localhost:5173
PORT=3000

# Local Postgres, or the Supabase pooler URLs for UAT
DATABASE_URL=postgres://postgres:postgres@localhost:5432/connect
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/connect
DB_POOL_MAX=5

SESSION_SECRET=change-me-local-only
INTERNAL_JOB_SECRET=change-me-local-only

STORAGE_DRIVER=local
STORAGE_BUCKET=connect-files
STORAGE_ENDPOINT=
STORAGE_KEY=

LOG_LEVEL=info
