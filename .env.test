# Integration tests only. Local Docker MongoDB replica set (see README); never point at UAT/Prod.
# Tests drop and recreate the connect_test database.
APP_ENV=test
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=connect_test
DB_POOL_MAX=5
SESSION_SECRET=test-only-not-a-secret
INTERNAL_JOB_SECRET=test-only-not-a-secret
CRON_SECRET=test-only-cron-secret
STORAGE_DRIVER=local
STORAGE_ENDPOINT=.storage-test
SEED_PASSWORD="Connect#Test2026"
LOG_LEVEL=error
